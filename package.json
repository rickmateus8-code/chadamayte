{
  "name": "mayte-baby-shower",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "wrangler dev",
    "typecheck": "tsc -b",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "check": "npm run typecheck && npm run typecheck:worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types worker/types/worker-configuration.d.ts"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^0.1.3",
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "better-sqlite3": "^11.8.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wrangler": "^3.109.2"
  }
}