{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "noEmit": true
  },
  "include": ["vite.config.ts", "test/**/*.ts"]
}