{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mayte-baby-shower",
  "main": "worker/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mayte-baby-shower-db",
      "database_id": "PLACEHOLDER_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "mayte-baby-shower-media"
    }
  ],
  "observability": {
    "enabled": true
  }
}